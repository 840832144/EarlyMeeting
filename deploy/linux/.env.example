# Paths and runtime account only; never put App Secret or AI Key here.
EARLYMEETING_CONFIG_HOST_DIR=/srv/earlymeeting/config
EARLYMEETING_DATA_HOST_DIR=/srv/earlymeeting/data
EARLYMEETING_UID=1000
EARLYMEETING_GID=1000
# Use a release/commit tag you built; keep the previous image for rollback.
EARLYMEETING_IMAGE_TAG=linux-v1
